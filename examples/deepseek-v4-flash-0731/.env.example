# Copy to .env on BOTH nodes. Keep .env private (it may contain HF_TOKEN).
# Find the point-to-point IPs using: ip -br address
HEAD_IP=10.10.0.1
WORKER_IP=10.10.0.2
# Find the RoCE interface / HCA using: ibdev2netdev; show_gids
QSFP_IFACE=enp1s0f0np0
IB_HCA=mlx5_0:1
IB_GID_INDEX=3

# Use an absolute, writable host path on each node. Paths can differ by host.
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface
RUNTIME_CACHE_DIR=/home/ubuntu/.cache/deepseek-v4-flash-runtime
# Supply a Hugging Face token if the checkpoint requires authentication.
HF_TOKEN=

# Do not float the qualified image or model revision.
IMAGE=ghcr.io/timothystewart6/vllm-gb10@sha256:39fc41b2e0a91d0c75fe03cbf00a715524bd8fab23114d37710a26e1de034333
MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
MODEL_REVISION=7872f01b1d1fe23eabc4c98b48bffcef5a386062

# A warmed, fully downloaded cache can use 1 for an offline production setup.
# Leave 0 on the first boot to allow the pinned model to download.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
