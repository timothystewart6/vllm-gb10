# versions.env - the authoritative source of truth for all build inputs.
# Every entry is a tag or exact version - no :latest, no main, no ranges.
# Run scripts/bump.sh to populate _COMMIT fields and regenerate lockfiles.
# All variables in this file are emitted as --build-arg by scripts/build-args.sh.
# Integration checklist:
# CONTRIBUTING.md#adding-or-changing-a-versionsenv-input

# ---------------------------------------------------------------------------
# Base OS / CUDA
# Pin by SHA256 digest (not just tag) - Docker Hub tags are mutable.
# Digest is resolved by bump.sh: docker buildx imagetools inspect (aarch64).
# ---------------------------------------------------------------------------
CUDA_BASE_IMAGE=nvidia/cuda:13.2.0-devel-ubuntu24.04
CUDA_BASE_DIGEST=sha256:a5b6256e470196fc1d5f8f62139d57d3662867746dfe1cb352d7652024047020

# Image stack revision.
# Reset to 0 each time VLLM_REF bumps to a new minor/patch.
# Incremented by bump.sh when any non-vLLM input changes on the same VLLM_REF.
GB10_BUILD=2

# ---------------------------------------------------------------------------
# Python / uv bootstrap
# ---------------------------------------------------------------------------
UV_VERSION=0.12.5

# ---------------------------------------------------------------------------
# PyTorch stack - exact versions from the cu130 index.
# torch==2.11.0 is pinned by vLLM v0.24.0 requirements/build/cuda.txt at
# VLLM_COMMIT. torchvision/torchaudio/triton are the cu130 releases
# tested compatible with that torch on aarch64 + CUDA 13.2.
# ---------------------------------------------------------------------------
TORCH_VERSION=2.13.0
TORCHVISION_VERSION=0.28.0
TORCHAUDIO_VERSION=2.11.0
TRITON_VERSION=3.7.1
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
PYPI_INDEX_URL=https://pypi.org/simple
FLASHINFER_INDEX_URL=https://flashinfer.ai/whl

# ---------------------------------------------------------------------------
# CUDA-side companion packages
# TVM_FFI_VERSION, TILELANG_VERSION, NUMBA_VERSION must match what vLLM
# requires at VLLM_REF (check requirements/cuda.txt at that commit).
# ---------------------------------------------------------------------------
NVSHMEM_VERSION=3.4.5
TVM_FFI_VERSION=0.1.11
TILELANG_VERSION=0.1.12
NUMBA_VERSION=0.65.0

# ---------------------------------------------------------------------------
# NCCL - pin by tag AND record commit SHA.
# Tags can be force-moved; the SHA is what makes the build reproducible.
# ---------------------------------------------------------------------------
NCCL_REPO=https://github.com/NVIDIA/nccl.git
NCCL_REF=v2.31.2-1
NCCL_COMMIT=7b83616df3ae082a1f32bb74c27458bfe8153a13

# ---------------------------------------------------------------------------
# vLLM - pin by tag, never main.
# Rule: highest released tag that is at least 7 days old (lets dust settle).
# ---------------------------------------------------------------------------
VLLM_REPO=https://github.com/vllm-project/vllm.git
VLLM_REF=v0.27.1
VLLM_COMMIT=6e448d0ea9bf3d88d898b65449ca6dc2aec170ac

# ---------------------------------------------------------------------------
# FlashInfer - pin by tag matching vLLM's requirements/cuda.txt pin.
# ---------------------------------------------------------------------------
FLASHINFER_REPO=https://github.com/flashinfer-ai/flashinfer.git
FLASHINFER_REF=v0.6.16.post3
FLASHINFER_COMMIT=9dc1b2495b40314dec8a8cde8cd7faf5c5206702

# ---------------------------------------------------------------------------
# Runtime lock seed versions.
# These are consumed by bump.sh when it regenerates locks/python-runtime.txt.
# They supplement or override what vLLM's own requirements files declare.
# RAY_VERSION, FASTSAFETENSORS_VERSION, INSTANTTENSOR_VERSION are also emitted
# as --build-arg (pass-through only; no Dockerfile ARG consumes them directly).
# QUACK_KERNELS_VERSION keeps the runtime compatible with the Cutlass DSL pin.
# ---------------------------------------------------------------------------
RAY_VERSION=2.57.0
FASTSAFETENSORS_VERSION=0.2.2
INSTANTTENSOR_VERSION=0.1.9
BITSANDBYTES_VERSION=0.49.2
ACCELERATE_VERSION=1.14.0
QUACK_KERNELS_VERSION=0.6.1

# ---------------------------------------------------------------------------
# Target GPU architecture
# ---------------------------------------------------------------------------
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
